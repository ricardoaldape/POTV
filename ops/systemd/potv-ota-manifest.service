[Unit]
Description=Refresh POTV legacy OTA manifest from verified official GitHub Releases
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/potv-bot
ExecStart=/usr/bin/python3 /opt/potv-bot/ota_manifest_sync.py --allow-beta
UMask=0022
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/potv-bot/version.json
PrivateTmp=true
MemoryMax=64M
TimeoutStartSec=40
