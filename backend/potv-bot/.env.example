# POTV bot/account backend
POTV_DB=/opt/potv-bot/potv.sqlite3
POTV_BOT_TOKEN=
BOT_USERNAME=potvoficialbot
BOT_ID=8938958703
ADMIN_TELEGRAM_ID=
API_HOST=127.0.0.1
API_PORT=8093

# Official community routing
POTV_GROUP_CHAT_ID=
POTV_GROUP_INVITE_URL=
POTV_BOT_PUBLIC_URL=https://t.me/potvoficialbot

# Commercial copy
PLAN_TEXT=POTV — acceso por suscripción
PAYMENT_TEXT=Datos de pago pendientes de configurar.

# Default account backend is local SQLite.
POTV_SUPABASE_MODE=local
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_KEY_FILE=

# Authorized content gateway. Keep the real source file outside Git.
# One M3U/Xtream URL per line (credentials may live here, never in the APK).
POTV_CONTENT_SOURCES_FILE=/opt/potv-bot/secrets/partner-sources.txt
POTV_CONTENT_METADATA_FILE=/opt/potv-bot/secrets/partner-content.json
POTV_CONTENT_SIGNING_SECRET=
POTV_PUBLIC_BASE_URL=https://potv.fxqubit.com
POTV_CONTENT_REFRESH_SECONDS=120

# Optional authorized LMHD-vendor API integration. No credentials in Git or APK.
# Configuration (base_url, token, device) OR
# (base_url, username, password, device) is an owner-provided JSON outside Git.
# The second form logs in automatically and renews its session. These values
# never appear in the APK, commits or catalog responses.
# Example path: /opt/potv-bot/secrets/lmhd-approved.json (mode 0600).
# The bridge is inert until the file exists and contains enabled=true.
POTV_LMHD_SERVICE_FILE=
# Optional dedicated username/password form (instead of static service file):
# POTV_LMHD_API_BASE_URL, POTV_LMHD_SERVICE_USERNAME,
# POTV_LMHD_SERVICE_PASSWORD, POTV_LMHD_SERVICE_DEVICE.
# These secrets belong on the VPS only, not GitHub or the Android client.
# Private, periodically refreshed LMHD snapshot; must be owned by POTV only.
# Run lmhd_catalog_sync.py every 5 minutes (example systemd unit in deploy/).
POTV_LMHD_SYNC_FILE=/opt/potv-bot/secrets/lmhd-catalog.json
# Both paid VOD and live catalogs stay off until POTV entitlement checks
# explicitly allow the signed output to reach a subscribed user.
POTV_LMHD_VOD_ENABLED=false
POTV_LMHD_INCLUDE_LIVE_CATALOG=false

# Optional: combine all licensed live-TV sources while keeping VOD failover.
# Allowed: merge | failover. Omit to inherit POTV_CONTENT_SOURCE_MODE.
POTV_CONTENT_LIVE_SOURCE_MODE=merge
