[Unit]
Description=Refresh POTV private LMHD content snapshot
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/potv-bot/secrets/lmhd-service.json

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/potv-bot
EnvironmentFile=/opt/potv-bot/.env
ExecStart=/usr/bin/python3 /opt/potv-bot/lmhd_catalog_sync.py
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/potv-bot/secrets
PrivateTmp=true
MemoryMax=160M
TimeoutStartSec=95
